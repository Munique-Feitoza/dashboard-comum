# Frontend variables. The publishable key is safe for browser use; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Edge Function secrets are configured separately with `supabase secrets set`.
# Do not put service-role credentials, Google secrets, or encryption keys in NEXT_PUBLIC_*.
APP_BASE_URL=
APP_ALLOWED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
